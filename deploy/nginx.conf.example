# MegaLog v5 — nginx config (uso LOCAL/LAN, sem domínio, sem TLS)
#
# Padrão recomendado:
#   - nginx serve a SPA estática (frontend/dist/) direto
#   - nginx faz proxy_pass de /api/* para o uvicorn em 127.0.0.1:5000
#   - histórico de URLs do vue-router resolvido via try_files → /index.html
#
# Acesso por IP (ex: http://192.168.1.10/) — server_name _ aceita qualquer Host.
# Para restringir à LAN, use o firewall (ufw/iptables) ou ajuste o `listen`.
#
# Pré-requisito: copiar deploy/nginx-ratelimit.conf para
# /etc/nginx/conf.d/megalog-ratelimit.conf (define a zone "megalog_auth"
# usada no location /api/auth/login). O install.sh faz isso automaticamente.

server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;

    client_max_body_size 8M;
    gzip on;
    gzip_types text/plain text/css application/javascript application/json;
    gzip_min_length 1024;

    # ── Security headers ─────────────────────────────────────────────────────
    # 'always' garante envio também em respostas 4xx/5xx.
    # add_header em sub-blocos (location) substitui o do server, então qualquer
    # location que use add_header próprio precisa repetir estes headers.
    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "same-origin" always;
    add_header Permissions-Policy "geolocation=(), microphone=(), camera=()" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;

    # ── SPA estática ─────────────────────────────────────────────────────────
    root @INSTALL_DIR@/frontend/dist;
    index index.html;

    # Assets versionados podem ter cache longo
    location /assets/ {
        access_log off;
        expires 1y;
        add_header Cache-Control "public, immutable";
        # Repete security headers (add_header em location sobrescreve o do server)
        add_header X-Frame-Options "DENY" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "same-origin" always;
        add_header Permissions-Policy "geolocation=(), microphone=(), camera=()" always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;
        try_files $uri =404;
    }

    # Histórico HTML5 do vue-router: qualquer rota não encontrada cai no SPA
    location / {
        try_files $uri $uri/ /index.html;
    }

    # ── API ──────────────────────────────────────────────────────────────────
    # Rate-limit específico para login (zone definida em conf.d/megalog-ratelimit.conf)
    location = /api/auth/login {
        limit_req zone=megalog_auth burst=5 nodelay;
        proxy_pass http://127.0.0.1:@WEB_PORT@;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }

    location /api/ {
        proxy_pass http://127.0.0.1:@WEB_PORT@;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }

    # ── Healthcheck (para monitoria local) ───────────────────────────────────
    location = /healthz {
        access_log off;
        proxy_pass http://127.0.0.1:@WEB_PORT@/api/healthz;
    }
}
