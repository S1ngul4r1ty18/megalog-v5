[Unit]
Description=MegaLog — Receptor UDP de syslog Mikrotik
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@MEGALOG_USER@
Group=@MEGALOG_USER@
WorkingDirectory=@INSTALL_DIR@
EnvironmentFile=@CONFIG_FILE@
ExecStart=@INSTALL_DIR@/.venv/bin/python -m megalog.ingest.receiver
Restart=always
RestartSec=5
LimitNOFILE=65535

# Permite bind em portas privilegiadas (UDP < 1024) sem rodar como root
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true

# Hardening
ProtectSystem=strict
ReadWritePaths=@STREAM_DIR@ @STATE_DIR@
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=true
LockPersonality=true
# Hardening avançado (SEC-08)
MemoryDenyWriteExecute=true
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
ProtectKernelLogs=true
ProtectClock=true
ProtectHostname=true
RemoveIPC=true

StandardOutput=journal
StandardError=journal
SyslogIdentifier=megalog-receiver

[Install]
WantedBy=multi-user.target
