[Unit]
Description=MegaLog — Backup state (ip_registry.db + megalog.db)
After=network.target

[Service]
Type=oneshot
User=@MEGALOG_USER@
Group=@MEGALOG_USER@
WorkingDirectory=@INSTALL_DIR@
EnvironmentFile=@CONFIG_FILE@
ExecStart=/usr/bin/python3 @INSTALL_DIR@/deploy/backup_state.py --src @STATE_DIR@ --dest @BACKUP_DIR@ --keep 8
Nice=19

NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=@STATE_DIR@ @BACKUP_DIR@
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
ProtectKernelLogs=true
ProtectClock=true
ProtectHostname=true
RemoveIPC=true

StandardOutput=journal
StandardError=journal
SyslogIdentifier=megalog-backup
