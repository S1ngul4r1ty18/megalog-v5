[Unit]
Description=MegaLog — API Web (Uvicorn + FastAPI)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@MEGALOG_USER@
Group=@MEGALOG_USER@
WorkingDirectory=@INSTALL_DIR@
EnvironmentFile=@CONFIG_FILE@
ExecStart=@INSTALL_DIR@/.venv/bin/python -m megalog.api.app
Restart=always
RestartSec=5

# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=@STATE_DIR@ @HOT_DIR@ @COLD_DIR@ @STREAM_DIR@
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
LockPersonality=true
# Hardening avançado (SEC-08)
MemoryDenyWriteExecute=true
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
ProtectKernelLogs=true
ProtectClock=true
ProtectHostname=true
RemoveIPC=true

StandardOutput=journal
StandardError=journal
SyslogIdentifier=megalog-web

[Install]
WantedBy=multi-user.target
