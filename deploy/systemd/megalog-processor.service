[Unit]
Description=MegaLog — Processador (tail .raw → DuckDB)
After=megalog-receiver.service
PartOf=megalog-receiver.service

[Service]
Type=simple
User=@MEGALOG_USER@
Group=@MEGALOG_USER@
WorkingDirectory=@INSTALL_DIR@
EnvironmentFile=@CONFIG_FILE@
ExecStart=@INSTALL_DIR@/.venv/bin/python -m megalog.ingest.processor
Restart=always
RestartSec=5
Nice=10

# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=@STREAM_DIR@ @STATE_DIR@ @HOT_DIR@ @COLD_DIR@
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
LockPersonality=true
# Hardening avançado (SEC-08)
MemoryDenyWriteExecute=true
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
ProtectKernelLogs=true
ProtectClock=true
ProtectHostname=true
RemoveIPC=true

StandardOutput=journal
StandardError=journal
SyslogIdentifier=megalog-processor

[Install]
WantedBy=multi-user.target
