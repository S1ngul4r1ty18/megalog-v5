# ── Python ──────────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.egg-info/
.eggs/
build/
dist/
*.egg

# venv local (regenerada pelo install.sh)
.venv/
venv/

# Caches de teste/lint
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# ── Frontend (Node/Vite) ────────────────────────────────────────────────────
frontend/node_modules/
frontend/.vite/
frontend/.cache/

# Logs locais do npm
frontend/npm-debug.log*
frontend/yarn-debug.log*
frontend/yarn-error.log*

# ── IDE / SO ────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ── Runtime / dados (nunca devem viajar pro repo) ───────────────────────────
